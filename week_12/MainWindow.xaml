<Window x:Class="week_12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:week_12"
        Title="WPF選課系統" Height="520" Width="900">
    <Grid Background="#FCFBF7">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F6F4E8">
            <TextBlock Text="學生" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="65,0,35,0" />
            <ComboBox x:Name="cmbStudent" Width="340" Height="36" FontSize="16"
                      VerticalAlignment="Center" VerticalContentAlignment="Center"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="cmbStudent_SelectionChanged" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="8,10,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="tabCourses" Grid.Column="0" FontSize="14"
                        SelectionChanged="tabCourses_SelectionChanged">
                <TabItem Header="以教師分類課程">
                    <TreeView x:Name="tvTeacherCourses" Background="#EAEFF6" BorderThickness="0" FontSize="14">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:Teacher}" ItemsSource="{Binding Courses}">
                                <TextBlock Text="{Binding TeacherTitle}" FontWeight="Bold" Padding="2" />
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type local:Course}">
                                <TextBlock Text="{Binding}" Padding="2" />
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </TabItem>

                <TabItem Header="所有課程">
                    <ListBox x:Name="lbAllCourses" Background="#EAEFF6" BorderThickness="0"
                             FontSize="14" SelectionMode="Extended" />
                </TabItem>
            </TabControl>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,52,0,0">
                <Button x:Name="btnSelect" Content="選課" Width="74" Height="42" FontSize="16"
                        Margin="0,0,0,22" Click="btnSelect_Click" />
                <Button x:Name="btnDrop" Content="退選" Width="74" Height="42" FontSize="16"
                        Margin="0,0,0,22" Click="btnDrop_Click" />
                <Button x:Name="btnSave" Content="存檔" Width="74" Height="42" FontSize="16"
                        Click="btnSave_Click" />
            </StackPanel>

            <ListBox x:Name="lbSelectedCourses" Grid.Column="2"
                     Background="#E5F1F1" BorderBrush="#A0A8A8" BorderThickness="1"
                     FontSize="14" SelectionMode="Extended" />
        </Grid>
    </Grid>
</Window>
